#!/usr/bin/env bash
# Blocks a push whose docs no longer describe the code.
#
# Versioned so it survives a clone, but git only uses it once per clone:
#   git config core.hooksPath .githooks
# The same check runs in CI, so forgetting that is caught server-side.
#
# Bypass for a genuine emergency: git push --no-verify
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECKER="$REPO_ROOT/tooling/check_docs.py"
[ -f "$CHECKER" ] && command -v python3 >/dev/null 2>&1 || exit 0

ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: no range to diff, so facts only.
    RANGE=""
  else
    RANGE="$remote_sha..$local_sha"
  fi

  echo "--- docs check ---"
  if [ -n "$RANGE" ]; then
    python3 "$CHECKER" --range "$RANGE" || STATUS=1
  else
    python3 "$CHECKER" || STATUS=1
  fi
done

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "Push blocked: the docs are out of date with the code."
  echo "Fix the items above (CHANGELOG.md is usually the right place), then push again."
  echo "To bypass in an emergency: git push --no-verify"
fi

exit "$STATUS"

# Keep Unity text-serialized files LF so git diffs match what Unity rewrites
*.unity text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.asmdef text eol=lf
*.mat text eol=lf
*.prefab text eol=lf
*.shader text eol=lf
*.cs text eol=lf
*.json text eol=lf

# Binary payloads. Nothing here was marked binary before, so a new .bytes or .wav relied
# entirely on git's content heuristic — and `*.asset text eol=lf` above is unconditional,
# which would silently LF-mangle any Unity asset written in binary mode.
*.bytes binary
*.wav binary
*.ogg binary
*.png binary
*.glb binary

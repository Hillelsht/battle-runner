{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tooling/hook_docs_gate.sh\"",
            "timeout": 30,
            "statusMessage": "Checking docs are current before push"
          }
        ]
      }
    ]
  }
}
